# === App ===
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-string
APP_CORS_ORIGINS=http://localhost:3000

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./smeltlab.db

# === AI（可选：不配也能用数据体检、预置清洗与训练卡建模）===
# glm | anthropic，二选一
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
# 使用智谱 GLM 时把上面两行换成：
# AI_PROVIDER=glm
# GLM_API_KEY=xxx
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4.5-air

# === Storage ===
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# === PiAgent（本地 agent 引擎，走 pi CLI） ===
PIAGENT_ENABLED=true
PIAGENT_EXE=pi
PIAGENT_TIMEOUT=600
PIAGENT_IDLE_TIMEOUT=240
PIAGENT_PROVIDER=
PIAGENT_MODEL=
PIAGENT_WORKSPACE_ROOT=
PIAGENT_SKILLS_ROOT=

# === Redis (optional for MVP) ===
REDIS_URL=redis://localhost:6379

# === Auth ===
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Stripe ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
